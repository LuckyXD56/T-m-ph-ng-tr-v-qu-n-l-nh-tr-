# Cấu hình ứng dụng Tìm phòng trọ và Quản lý nhà trọ (LTW19)
APP_NAME="Trọ Sinh Viên - LTW19"
APP_DEBUG=false

# Để trống để tự nhận diện đường dẫn gốc (chạy được cả php -S và Apache /tro_sinh_vien)
APP_BASE_PATH=

# Driver CSDL: sqlite (mặc định chạy ngay không cần cài đặt), pgsql (PostgreSQL), hoặc mysql
DB_DRIVER=sqlite
DB_SQLITE_PATH=database/tro_sinh_vien.sqlite

# Cấu hình PostgreSQL / MySQL (khi đặt DB_DRIVER=pgsql hoặc mysql)
DB_HOST=localhost
DB_PORT=5432
DB_DATABASE=tro_sinh_vien
DB_USERNAME=postgres
DB_PASSWORD=your_password_here
